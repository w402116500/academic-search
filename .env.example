# 工作区环境变量参考
#
# Docker Compose 读取 infra/compose/.env（先复制同目录的 .env.example）。
# 后端读取项目根目录 .env，前端读取 frontend/.env。
# 此文件集中列出后端应用运行时配置；不要将真实密钥提交到版本库。

# 应用运行环境
APP_ENV=development
LOG_LEVEL=INFO

# 本地账号认证。使用至少 32 个随机字符；不要使用示例值，也不要提交真实密钥。
# 生成示例：uv run --directory backend python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET_KEY=
AUTH_JWT_ISSUER=academic-search
AUTH_JWT_ACCESS_TOKEN_MINUTES=60

# 宿主机连接 Docker 服务
DATABASE_URL=postgresql+asyncpg://academic_search:academic_search_dev@localhost:55432/academic_search
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://localhost:19530
# 本地 Milvus 不需要 Token；托管 Milvus 或生产环境按服务商要求设置。
MILVUS_TOKEN=
# 本项目的 L3 向量集合。不要与其他项目共用同一个集合名。
MILVUS_COLLECTION_NAME=academic_document_chunks_l3_v1

# S3 兼容对象存储。部署时替换为 OSS/COS 的凭据与 Endpoint。
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=academic-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# 全文获取：首版只自动下载 Provider 已明确标为开放获取的 HTTPS 直链 PDF。
# 下载成功后先写入以下暂存前缀；后续“加入研究集合”服务会创建数据库记录并负责转正或清理。
FULLTEXT_DOWNLOAD_TIMEOUT_SECONDS=30
FULLTEXT_TOTAL_TIMEOUT_SECONDS=90
FULLTEXT_MAX_FILE_SIZE_BYTES=52428800
FULLTEXT_MAX_REDIRECTS=3
FULLTEXT_STAGING_PREFIX=staging/fulltext
# 仅当开放获取全文直连不可用时改为 proxy；代理地址复用 LITERATURE_PROXY_URL。
FULLTEXT_NETWORK_MODE=direct

# OpenAI 兼容模型服务。真实 API Key 仅保存在本地 .env 文件中。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# 首页研究要求解析的单次模型调用超时；超时后计划会标记失败，可修改后重新生成。
WORKFLOW_INTENT_TIMEOUT_SECONDS=45

# RAG 文献入库：PDF 按页解析后建立 L1/L2/L3 父子块，只有 L3 会写入 Milvus。
# 字符上限用于保持模型输入稳定；token 数使用下方 tiktoken 编码精确统计。
RAG_MAX_L1_CHARACTERS=12000
RAG_MAX_L2_CHARACTERS=4000
RAG_MAX_L3_CHARACTERS=1200
RAG_L3_OVERLAP_CHARACTERS=160
RAG_TOKENIZER_ENCODING=cl100k_base
# 单次 OpenAI 兼容 embedding 请求中包含的 L3 片段数量。
RAG_EMBEDDING_BATCH_SIZE=16

# 文献源获取。候选检索结果只会短期保存在 Redis，不会直接写入 PostgreSQL。
SEARCH_HTTP_TIMEOUT_SECONDS=10
SEARCH_MAX_CONCURRENT_PROVIDERS=3
SEARCH_SESSION_TTL_SECONDS=7200
SEARCH_PROVIDER_CACHE_TTL_SECONDS=1800

# 文献来源网络路由。direct 表示直连；proxy 表示仅对此来源显式使用下方代理地址。
# 应用不会读取 HTTP_PROXY、HTTPS_PROXY 等进程全局代理变量，避免不同来源相互影响。
LITERATURE_DEFAULT_NETWORK_MODE=direct
LITERATURE_PROXY_URL=http://127.0.0.1:7897

# OpenAlex：主候选召回，可提供摘要、引用量与开放获取信息。
# API Key 属于敏感信息，只填写在本地 .env 或部署平台的密钥配置中。
OPENALEX_ENABLED=true
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_CONTACT_EMAIL=
OPENALEX_PAGE_SIZE=25
OPENALEX_MAX_RESULTS=50
OPENALEX_RATE_LIMIT_PER_MINUTE=60
# 当前网络环境下 OpenAlex 建议走本地代理；没有代理时改为 direct。
OPENALEX_NETWORK_MODE=proxy

# Crossref：补全 DOI 与出版元数据，并参与正式题录交叉核验。
CROSSREF_ENABLED=true
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_CONTACT_EMAIL=
CROSSREF_PAGE_SIZE=25
CROSSREF_MAX_RESULTS=50
CROSSREF_RATE_LIMIT_PER_MINUTE=50
# Crossref 已验证可直连。
CROSSREF_NETWORK_MODE=direct

# arXiv：预印本发现来源。预印本不能单独作为正式题录依据。
# arXiv 建议相邻两次请求至少间隔 3 秒。
ARXIV_ENABLED=false
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_MAX_RESULTS=30
ARXIV_MIN_REQUEST_INTERVAL_SECONDS=3
# 可填写开发者邮箱，作为可识别 User-Agent 的联系信息；不填写也可运行。
ARXIV_CONTACT_EMAIL=
# arXiv 在当前网络环境应直连，避免代理出口的 429 与超时。
ARXIV_NETWORK_MODE=direct

# Semantic Scholar：用于补充摘要、引用量和引用网络。
SEMANTIC_SCHOLAR_ENABLED=false
# official 使用官方 API 与 x-api-key；ominiai 使用 S2API 兼容网关与 Bearer Token。
SEMANTIC_SCHOLAR_ACCESS_MODE=official
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
S2API_OMINIAI_BASE_URL=https://s2api.ominiai.cn/s2/graph/v1
S2API_OMINIAI_API_KEY=
SEMANTIC_SCHOLAR_MAX_RESULTS=30
SEMANTIC_SCHOLAR_RATE_LIMIT_PER_MINUTE=30
# Ominiai 已验证可直连；官方 API 也可按网络环境改为 proxy。
SEMANTIC_SCHOLAR_NETWORK_MODE=direct

# DOI 内容协商：用户复制题录或加入研究集合时，按需补全格式中立的权威题录。
DOI_RESOLVER_BASE_URL=https://doi.org
DOI_RESOLVER_TIMEOUT_SECONDS=10
# DOI 服务默认继承全局网络路由；当前网络可直连，必要时单独改为 proxy。
DOI_RESOLVER_NETWORK_MODE=direct

# 前端运行环境
VITE_API_BASE_URL=http://localhost:8000
