{
  "name": "@academic-search/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0 <21",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:export": "uv run --project ../backend python ../scripts/export_openapi.py",
    "api:generate": "corepack pnpm api:export && corepack pnpm exec openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.ts && corepack pnpm exec prettier --write src/api/generated/openapi.json src/api/generated/schema.ts",
    "api:check": "corepack pnpm api:generate && git diff --exit-code -- src/api/generated/openapi.json src/api/generated/schema.ts && git ls-files --error-unmatch src/api/generated/openapi.json src/api/generated/schema.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.62.0",
    "@lucide/vue": "^1.27.0",
    "pinia": "^3.0.1",
    "reka-ui": "^2.1.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^20.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}
